{
  "name": "gascity-cockpit",
  "displayName": "GasCity Cockpit",
  "description": "An adaptive, in-editor cockpit for monitoring and driving your gas cities, built on the gascity /v0 HTTP API.",
  "version": "0.0.1",
  "publisher": "gastown",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsgerman-oss/gascity-cockpit.git"
  },
  "keywords": [
    "gascity",
    "gas town",
    "agents",
    "beads",
    "cockpit"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gascityCockpit",
          "title": "GasCity Cockpit",
          "icon": "media/cockpit.svg"
        }
      ]
    },
    "views": {
      "gascityCockpit": [
        {
          "id": "gascityCockpit.fleet",
          "name": "Fleet"
        },
        {
          "id": "gascityCockpit.events",
          "name": "Event Feed"
        },
        {
          "id": "gascityCockpit.beads",
          "name": "Beads",
          "icon": "media/cockpit.svg",
          "contextualTitle": "GasCity Beads"
        },
        {
          "id": "gascityCockpit.telemetry",
          "name": "Cost & Tier",
          "icon": "media/cockpit.svg",
          "contextualTitle": "GasCity Cost & Tier"
        },
        {
          "id": "gascityCockpit.mergeQueue",
          "name": "Merge Queue",
          "icon": "media/cockpit.svg",
          "contextualTitle": "GasCity Merge Queue"
        }
      ]
    },
    "commands": [
      {
        "command": "gascityCockpit.reconnect",
        "title": "GasCity Cockpit: Reconnect to Supervisor API",
        "category": "GasCity Cockpit",
        "icon": "$(plug)"
      },
      {
        "command": "gascityCockpit.showStatus",
        "title": "GasCity Cockpit: Show Connection Status",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.checkConnection",
        "title": "GasCity Cockpit: Check API Connection",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.refreshStatus",
        "title": "GasCity Cockpit: Refresh Live Status",
        "category": "GasCity Cockpit",
        "icon": "$(refresh)"
      },
      {
        "command": "gascityCockpit.beads.refresh",
        "title": "Refresh Beads",
        "category": "GasCity Beads",
        "icon": "$(refresh)"
      },
      {
        "command": "gascityCockpit.beads.setGroupBy",
        "title": "Group Beads By…",
        "category": "GasCity Beads",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "gascityCockpit.beads.toggleClosed",
        "title": "Toggle Closed Beads",
        "category": "GasCity Beads",
        "icon": "$(eye)"
      },
      {
        "command": "gascityCockpit.beads.filter",
        "title": "Filter Beads…",
        "category": "GasCity Beads",
        "icon": "$(filter)"
      },
      {
        "command": "gascityCockpit.beads.clearFilters",
        "title": "Clear Bead Filters",
        "category": "GasCity Beads",
        "icon": "$(clear-all)"
      },
      {
        "command": "gascityCockpit.beads.openDetail",
        "title": "Open Bead Detail",
        "category": "GasCity Beads",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gascityCockpit.beads.showGraph",
        "title": "Show Dependency Graph",
        "category": "GasCity Beads",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gascityCockpit.beads.copyId",
        "title": "Copy Bead ID",
        "category": "GasCity Beads",
        "icon": "$(copy)"
      },
      {
        "command": "gascityCockpit.clearTelemetry",
        "title": "GasCity Cockpit: Clear Telemetry",
        "category": "GasCity Cockpit",
        "icon": "$(clear-all)"
      },
      {
        "command": "gascityCockpit.code.openWorktree",
        "title": "Open Worktree…",
        "category": "GasCity Beads",
        "icon": "$(repo)"
      },
      {
        "command": "gascityCockpit.code.showDiff",
        "title": "Show Worktree Diff",
        "category": "GasCity Beads",
        "icon": "$(diff)"
      },
      {
        "command": "gascityCockpit.code.browseChangedFiles",
        "title": "Browse Changed Files",
        "category": "GasCity Beads",
        "icon": "$(list-tree)"
      },
      {
        "command": "gascityCockpit.beads.runTdd",
        "title": "Run TDD Flow…",
        "category": "GasCity Beads",
        "icon": "$(beaker)"
      },
      {
        "command": "gascityCockpit.formulas.preview",
        "title": "GasCity Cockpit: Preview Formula",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.formulas.showRuns",
        "title": "GasCity Cockpit: Watch Formula Runs",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.openChat",
        "title": "GasCity Cockpit: Open Chat (Mayor / agent)",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.openDashboard",
        "title": "GasCity Cockpit: Open Dashboard",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.extmsg.showStatus",
        "title": "GasCity Cockpit: Show extmsg Participant Status",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.mergeQueue.refresh",
        "title": "Refresh Merge Queue",
        "category": "GasCity Merge Queue",
        "icon": "$(refresh)"
      },
      {
        "command": "gascityCockpit.mergeQueue.toggleMerged",
        "title": "Toggle Recently Merged",
        "category": "GasCity Merge Queue",
        "icon": "$(git-merge)"
      },
      {
        "command": "gascityCockpit.mergeQueue.reviewChanges",
        "title": "Review Changes",
        "category": "GasCity Merge Queue",
        "icon": "$(diff)"
      },
      {
        "command": "gascityCockpit.mergeQueue.openPr",
        "title": "Open Pull Request",
        "category": "GasCity Merge Queue",
        "icon": "$(link-external)"
      },
      {
        "command": "gascityCockpit.mergeQueue.approveMerge",
        "title": "Approve & Merge…",
        "category": "GasCity Merge Queue",
        "icon": "$(check)"
      },
      {
        "command": "gascityCockpit.mergeQueue.copyBranch",
        "title": "Copy Branch Name",
        "category": "GasCity Merge Queue",
        "icon": "$(clippy)"
      },
      {
        "command": "gascityCockpit.beads.newFromSelection",
        "title": "New Bead from Selection…",
        "category": "GasCity Beads",
        "icon": "$(add)"
      },
      {
        "command": "gascityCockpit.fleetQuery.open",
        "title": "Query Fleet…",
        "category": "GasCity Cockpit",
        "icon": "$(search)"
      },
      {
        "command": "gascityCockpit.notifications.showPending",
        "title": "GasCity Cockpit: Show Pending Approvals",
        "category": "GasCity Cockpit",
        "icon": "$(bell)"
      },
      {
        "command": "gascityCockpit.timeTravel.open",
        "title": "Event Time-Travel…",
        "category": "GasCity Cockpit",
        "icon": "$(history)"
      },
      {
        "command": "gascityCockpit.townTopology.show",
        "title": "GasCity Cockpit: Show Town Topology",
        "category": "GasCity Cockpit",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gascityCockpit.worktreeLens.show",
        "title": "Show Worktrees Editing This File",
        "category": "GasCity Cockpit",
        "icon": "$(eye)"
      },
      {
        "command": "gascityCockpit.worktreeLens.refresh",
        "title": "Refresh Worktree Lens",
        "category": "GasCity Cockpit",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gascityCockpit.refreshStatus",
          "when": "view == gascityCockpit.fleet",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.reconnect",
          "when": "view == gascityCockpit.fleet",
          "group": "navigation@2"
        },
        {
          "command": "gascityCockpit.refreshStatus",
          "when": "view == gascityCockpit.events",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.beads.filter",
          "when": "view == gascityCockpit.beads",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.beads.setGroupBy",
          "when": "view == gascityCockpit.beads",
          "group": "navigation@2"
        },
        {
          "command": "gascityCockpit.beads.toggleClosed",
          "when": "view == gascityCockpit.beads",
          "group": "navigation@3"
        },
        {
          "command": "gascityCockpit.beads.refresh",
          "when": "view == gascityCockpit.beads",
          "group": "navigation@4"
        },
        {
          "command": "gascityCockpit.beads.clearFilters",
          "when": "view == gascityCockpit.beads",
          "group": "1_filters"
        },
        {
          "command": "gascityCockpit.clearTelemetry",
          "when": "view == gascityCockpit.telemetry",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.mergeQueue.toggleMerged",
          "when": "view == gascityCockpit.mergeQueue",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.mergeQueue.refresh",
          "when": "view == gascityCockpit.mergeQueue",
          "group": "navigation@2"
        },
        {
          "command": "gascityCockpit.timeTravel.open",
          "when": "view == gascityCockpit.events",
          "group": "navigation@2"
        },
        {
          "command": "gascityCockpit.townTopology.show",
          "when": "view == gascityCockpit.fleet",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gascityCockpit.beads.showGraph",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "inline@1"
        },
        {
          "command": "gascityCockpit.beads.openDetail",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "1_bead@1"
        },
        {
          "command": "gascityCockpit.beads.showGraph",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "1_bead@2"
        },
        {
          "command": "gascityCockpit.beads.copyId",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "1_bead@3"
        },
        {
          "command": "gascityCockpit.code.showDiff",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "inline@2"
        },
        {
          "command": "gascityCockpit.code.openWorktree",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "2_code@1"
        },
        {
          "command": "gascityCockpit.code.showDiff",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "2_code@2"
        },
        {
          "command": "gascityCockpit.code.browseChangedFiles",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "2_code@3"
        },
        {
          "command": "gascityCockpit.beads.runTdd",
          "when": "view == gascityCockpit.beads && viewItem == gascityBead",
          "group": "2_code@4"
        },
        {
          "command": "gascityCockpit.mergeQueue.reviewChanges",
          "when": "view == gascityCockpit.mergeQueue && viewItem =~ /^mergeEntry/",
          "group": "inline@1"
        },
        {
          "command": "gascityCockpit.mergeQueue.approveMerge",
          "when": "view == gascityCockpit.mergeQueue && viewItem =~ /^mergeEntry/",
          "group": "inline@2"
        },
        {
          "command": "gascityCockpit.mergeQueue.reviewChanges",
          "when": "view == gascityCockpit.mergeQueue && viewItem =~ /^mergeEntry/",
          "group": "1_review@1"
        },
        {
          "command": "gascityCockpit.mergeQueue.openPr",
          "when": "view == gascityCockpit.mergeQueue && viewItem == mergeEntry.pr",
          "group": "1_review@2"
        },
        {
          "command": "gascityCockpit.mergeQueue.approveMerge",
          "when": "view == gascityCockpit.mergeQueue && viewItem =~ /^mergeEntry/",
          "group": "1_review@3"
        },
        {
          "command": "gascityCockpit.mergeQueue.copyBranch",
          "when": "view == gascityCockpit.mergeQueue && viewItem =~ /^mergeEntry/",
          "group": "2_meta@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gascityCockpit.beads.openDetail",
          "when": "false"
        },
        {
          "command": "gascityCockpit.beads.showGraph",
          "when": "false"
        },
        {
          "command": "gascityCockpit.beads.copyId",
          "when": "false"
        },
        {
          "command": "gascityCockpit.code.openWorktree",
          "when": "false"
        },
        {
          "command": "gascityCockpit.code.showDiff",
          "when": "false"
        },
        {
          "command": "gascityCockpit.code.browseChangedFiles",
          "when": "false"
        },
        {
          "command": "gascityCockpit.beads.runTdd",
          "when": "false"
        },
        {
          "command": "gascityCockpit.mergeQueue.reviewChanges",
          "when": "false"
        },
        {
          "command": "gascityCockpit.mergeQueue.openPr",
          "when": "false"
        },
        {
          "command": "gascityCockpit.mergeQueue.approveMerge",
          "when": "false"
        },
        {
          "command": "gascityCockpit.mergeQueue.copyBranch",
          "when": "false"
        },
        {
          "command": "gascityCockpit.worktreeLens.show",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gascityCockpit.beads.newFromSelection",
          "when": "editorTextFocus",
          "group": "z_commands@1"
        }
      ]
    },
    "configuration": {
      "title": "GasCity Cockpit",
      "properties": {
        "gascityCockpit.api.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit base URL of the gascity supervisor API (e.g. `http://127.0.0.1:8372`). Highest-priority discovery source — overrides the discovery descriptor and the default. Leave empty to auto-discover."
        },
        "gascityCockpit.api.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional bearer token sent as `Authorization: Bearer <token>` to the supervisor API. Leave empty for the default localhost (unauthenticated) setup."
        },
        "gascityCockpit.api.healthPollSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "markdownDescription": "How often (seconds) to poll `/health` while connected, to detect the API going away (e.g. `gc stop` or a supervisor restart)."
        },
        "gascityCockpit.api.reconnect.baseDelayMs": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "markdownDescription": "Base delay (ms) for exponential reconnect backoff after the API becomes unreachable."
        },
        "gascityCockpit.api.reconnect.maxDelayMs": {
          "type": "number",
          "default": 15000,
          "minimum": 500,
          "markdownDescription": "Ceiling (ms) for exponential reconnect backoff."
        },
        "gascityCockpit.dashboard.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of the gascity dashboard to **project** (embed) into a Cockpit webview tab (e.g. `http://127.0.0.1:5173`). Leave empty to show a configure placeholder. The dashboard must be embeddable — webview-safe framing/CSP — and is themed and given tokenized `/v0` access from the host over the embed bridge, so do **not** put an API token in this URL. Run `GasCity Cockpit: Open Dashboard` to project it."
        },
        "gascityCockpit.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Master switch for native notifications. When off, no toasts are shown for escalations, tool-approvals, or mail."
        },
        "gascityCockpit.notifications.escalations": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a warning toast when an agent needs attention — a session crashes, strands, is quarantined, fails to start/drain, or an order/request fails."
        },
        "gascityCockpit.notifications.approvals": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a toast when an agent pauses for a tool-approval or asks a question, with inline Allow/Deny for tool-approvals. Aggregated across every running city."
        },
        "gascityCockpit.notifications.mail": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show an info toast when new mail is sent on the fleet. Covers all fleet mail traffic — disable if it is too chatty."
        },
        "gascityCockpit.notifications.approvalPollSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "markdownDescription": "How often (seconds) to poll `/v0/city/{city}/pending` for new approvals as a backstop, in addition to polling immediately after each session change."
        },
        "gascityCockpit.worktreeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Annotate files with the in-flight beads/polecats whose worktrees are editing them right now (a CodeLens at the top of the file plus an Explorer badge). Turn off to silence the lens."
        },
        "gascityCockpit.worktreeLens.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "markdownDescription": "How often (seconds) to re-scan the fleet's worktrees for the code lens. Each scan runs read-only `git diff` in every in-progress bead's worktree; lower values are fresher but busier."
        }
      }
    }
  },
  "scripts": {
    "generate": "node scripts/generate-client.mjs",
    "generate:live": "node scripts/generate-client.mjs --live",
    "sync:contributes": "node scripts/sync-contributes.mjs",
    "sync:contributes:check": "node scripts/sync-contributes.mjs --check",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
