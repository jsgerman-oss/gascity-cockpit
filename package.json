{
  "name": "gascity-cockpit",
  "displayName": "GasCity Cockpit",
  "description": "An adaptive, in-editor cockpit for monitoring and driving your gas cities, built on the gascity /v0 HTTP API.",
  "version": "0.0.1",
  "publisher": "gastown",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsgerman-oss/gascity-cockpit.git"
  },
  "keywords": [
    "gascity",
    "gas town",
    "agents",
    "beads",
    "cockpit"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gascityCockpit",
          "title": "GasCity Cockpit",
          "icon": "media/cockpit.svg"
        }
      ]
    },
    "views": {
      "gascityCockpit": [
        {
          "id": "gascityCockpit.fleet",
          "name": "Fleet"
        },
        {
          "id": "gascityCockpit.events",
          "name": "Event Feed"
        },
        {
          "id": "gascityCockpit.beads",
          "name": "Beads",
          "icon": "media/cockpit.svg",
          "contextualTitle": "GasCity Beads"
        }
      ]
    },
    "commands": [
      {
        "command": "gascityCockpit.reconnect",
        "title": "GasCity Cockpit: Reconnect to Supervisor API",
        "category": "GasCity Cockpit",
        "icon": "$(plug)"
      },
      {
        "command": "gascityCockpit.showStatus",
        "title": "GasCity Cockpit: Show Connection Status",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.checkConnection",
        "title": "GasCity Cockpit: Check API Connection",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.refreshStatus",
        "title": "GasCity Cockpit: Refresh Live Status",
        "category": "GasCity Cockpit",
        "icon": "$(refresh)"
      },
      {
        "command": "gascityCockpit.openChat",
        "title": "GasCity Cockpit: Open Chat (Mayor / agent)",
        "category": "GasCity Cockpit"
      },
      {
        "command": "gascityCockpit.beads.refresh",
        "title": "Refresh Beads",
        "category": "GasCity Beads",
        "icon": "$(refresh)"
      },
      {
        "command": "gascityCockpit.beads.setGroupBy",
        "title": "Group Beads By…",
        "category": "GasCity Beads",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "gascityCockpit.beads.toggleClosed",
        "title": "Toggle Closed Beads",
        "category": "GasCity Beads",
        "icon": "$(eye)"
      },
      {
        "command": "gascityCockpit.beads.filter",
        "title": "Filter Beads…",
        "category": "GasCity Beads",
        "icon": "$(filter)"
      },
      {
        "command": "gascityCockpit.beads.clearFilters",
        "title": "Clear Bead Filters",
        "category": "GasCity Beads",
        "icon": "$(clear-all)"
      },
      {
        "command": "gascityCockpit.beads.openDetail",
        "title": "Open Bead Detail",
        "category": "GasCity Beads",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gascityCockpit.beads.showGraph",
        "title": "Show Dependency Graph",
        "category": "GasCity Beads",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gascityCockpit.beads.copyId",
        "title": "Copy Bead ID",
        "category": "GasCity Beads",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gascityCockpit.refreshStatus",
          "when": "view == gascityCockpit.fleet",
          "group": "navigation@1"
        },
        {
          "command": "gascityCockpit.reconnect",
          "when": "view == gascityCockpit.fleet",
          "group": "navigation@2"
        },
        {
          "command": "gascityCockpit.refreshStatus",
          "when": "view == gascityCockpit.events",
          "group": "navigation@1"
        },
        { "command": "gascityCockpit.beads.filter", "when": "view == gascityCockpit.beads", "group": "navigation@1" },
        { "command": "gascityCockpit.beads.setGroupBy", "when": "view == gascityCockpit.beads", "group": "navigation@2" },
        { "command": "gascityCockpit.beads.toggleClosed", "when": "view == gascityCockpit.beads", "group": "navigation@3" },
        { "command": "gascityCockpit.beads.refresh", "when": "view == gascityCockpit.beads", "group": "navigation@4" },
        { "command": "gascityCockpit.beads.clearFilters", "when": "view == gascityCockpit.beads", "group": "1_filters" }
      ],
      "view/item/context": [
        { "command": "gascityCockpit.beads.showGraph", "when": "view == gascityCockpit.beads && viewItem == gascityBead", "group": "inline" },
        { "command": "gascityCockpit.beads.openDetail", "when": "view == gascityCockpit.beads && viewItem == gascityBead", "group": "1_bead@1" },
        { "command": "gascityCockpit.beads.showGraph", "when": "view == gascityCockpit.beads && viewItem == gascityBead", "group": "1_bead@2" },
        { "command": "gascityCockpit.beads.copyId", "when": "view == gascityCockpit.beads && viewItem == gascityBead", "group": "1_bead@3" }
      ],
      "commandPalette": [
        { "command": "gascityCockpit.beads.openDetail", "when": "false" },
        { "command": "gascityCockpit.beads.showGraph", "when": "false" },
        { "command": "gascityCockpit.beads.copyId", "when": "false" }
      ]
    },
    "configuration": {
      "title": "GasCity Cockpit",
      "properties": {
        "gascityCockpit.api.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit base URL of the gascity supervisor API (e.g. `http://127.0.0.1:8372`). Highest-priority discovery source — overrides the discovery descriptor and the default. Leave empty to auto-discover."
        },
        "gascityCockpit.api.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional bearer token sent as `Authorization: Bearer <token>` to the supervisor API. Leave empty for the default localhost (unauthenticated) setup."
        },
        "gascityCockpit.api.healthPollSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "markdownDescription": "How often (seconds) to poll `/health` while connected, to detect the API going away (e.g. `gc stop` or a supervisor restart)."
        },
        "gascityCockpit.api.reconnect.baseDelayMs": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "markdownDescription": "Base delay (ms) for exponential reconnect backoff after the API becomes unreachable."
        },
        "gascityCockpit.api.reconnect.maxDelayMs": {
          "type": "number",
          "default": 15000,
          "minimum": 500,
          "markdownDescription": "Ceiling (ms) for exponential reconnect backoff."
        }
      }
    }
  },
  "scripts": {
    "generate": "node scripts/generate-client.mjs",
    "generate:live": "node scripts/generate-client.mjs --live",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
