{
  "viewsContainers": {
    "activitybar": [
      {
        "id": "gascityCockpitGhostex",
        "title": "Ghostex",
        "icon": "media/cockpit.svg"
      }
    ]
  },
  "views": {
    "gascityCockpitGhostex": [
      {
        "id": "gascityCockpitGhostex.sessions",
        "name": "Sessions",
        "icon": "media/cockpit.svg",
        "contextualTitle": "Ghostex Sessions"
      }
    ]
  },
  "commands": [
    {
      "command": "gascityCockpit.ghostex.refresh",
      "title": "Refresh Ghostex",
      "category": "Ghostex",
      "icon": "$(refresh)"
    },
    {
      "command": "gascityCockpit.ghostex.checkConnection",
      "title": "Ghostex: Check gxserver Connection",
      "category": "Ghostex",
      "icon": "$(plug)"
    },
    {
      "command": "gascityCockpit.ghostex.showOutput",
      "title": "Ghostex: Show Output",
      "category": "Ghostex",
      "icon": "$(output)"
    },
    {
      "command": "gascityCockpit.ghostex.createSession",
      "title": "Create Terminal Session",
      "category": "Ghostex",
      "icon": "$(terminal)"
    },
    {
      "command": "gascityCockpit.ghostex.createAgentSession",
      "title": "Create Agent Session",
      "category": "Ghostex",
      "icon": "$(add)"
    },
    {
      "command": "gascityCockpit.ghostex.renameSession",
      "title": "Rename Session",
      "category": "Ghostex",
      "icon": "$(edit)"
    },
    {
      "command": "gascityCockpit.ghostex.focusSession",
      "title": "Reveal Session in Ghostex",
      "category": "Ghostex",
      "icon": "$(eye)"
    },
    {
      "command": "gascityCockpit.ghostex.sleepSession",
      "title": "Sleep Session",
      "category": "Ghostex",
      "icon": "$(debug-pause)"
    },
    {
      "command": "gascityCockpit.ghostex.wakeSession",
      "title": "Wake Session",
      "category": "Ghostex",
      "icon": "$(debug-start)"
    },
    {
      "command": "gascityCockpit.ghostex.killSession",
      "title": "Kill Session",
      "category": "Ghostex",
      "icon": "$(trash)"
    },
    {
      "command": "gascityCockpit.ghostex.sendText",
      "title": "Send Text to Session",
      "category": "Ghostex",
      "icon": "$(pencil)"
    },
    {
      "command": "gascityCockpit.ghostex.sendMessage",
      "title": "Send Message to Session",
      "category": "Ghostex",
      "icon": "$(send)"
    },
    {
      "command": "gascityCockpit.ghostex.readText",
      "title": "Read Session Output",
      "category": "Ghostex",
      "icon": "$(output)"
    },
    {
      "command": "gascityCockpit.ghostex.session.copyRef",
      "title": "Ghostex: Copy Session Reference",
      "category": "Ghostex",
      "icon": "$(copy)"
    }
  ],
  "menus": {
    "commandPalette": [
      { "command": "gascityCockpit.ghostex.session.copyRef", "when": "false" }
    ],
    "view/title": [
      {
        "command": "gascityCockpit.ghostex.createAgentSession",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@0"
      },
      {
        "command": "gascityCockpit.ghostex.refresh",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@1"
      },
      {
        "command": "gascityCockpit.ghostex.checkConnection",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@2"
      }
    ],
    "view/item/context": [
      {
        "command": "gascityCockpit.ghostex.focusSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "inline@1"
      },
      {
        "command": "gascityCockpit.ghostex.sendMessage",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "inline@2"
      },
      {
        "command": "gascityCockpit.ghostex.sendText",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "1_drive@1"
      },
      {
        "command": "gascityCockpit.ghostex.sendMessage",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "1_drive@2"
      },
      {
        "command": "gascityCockpit.ghostex.readText",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "1_drive@3"
      },
      {
        "command": "gascityCockpit.ghostex.focusSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "2_lifecycle@1"
      },
      {
        "command": "gascityCockpit.ghostex.sleepSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "2_lifecycle@2"
      },
      {
        "command": "gascityCockpit.ghostex.wakeSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "2_lifecycle@3"
      },
      {
        "command": "gascityCockpit.ghostex.killSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "2_lifecycle@4"
      },
      {
        "command": "gascityCockpit.ghostex.renameSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "3_meta@1"
      },
      {
        "command": "gascityCockpit.ghostex.session.copyRef",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession/",
        "group": "3_meta@2"
      }
    ]
  },
  "configuration": {
    "title": "GasCity Cockpit",
    "properties": {
      "gascityCockpit.ghostex.gxPath": {
        "type": "string",
        "default": "gx",
        "markdownDescription": "Path to the Ghostex `gx` CLI binary. Default `gx` (resolved on `PATH`). Set an absolute path if `gx` is not on the editor's `PATH`."
      },
      "gascityCockpit.ghostex.commandTransport": {
        "type": "string",
        "enum": ["cli", "rpc"],
        "default": "cli",
        "markdownEnumDescriptions": [
          "Drive sessions through the `gx` CLI (stable public contract; handles auth/remote). Recommended default.",
          "Drive sessions through the gxserver RPC daemon directly (lower latency; you manage the URL + token)."
        ],
        "markdownDescription": "Transport for the `gascityCockpit.ghostex.*` session commands (create / send / read / lifecycle). Reads/real-time always use RPC; this only selects the command transport."
      },
      "gascityCockpit.ghostex.gxserverUrl": {
        "type": "string",
        "default": "",
        "markdownDescription": "Base URL of the gxserver RPC daemon (e.g. `http://127.0.0.1:58744`). Leave empty to use the documented local default. Overrides discovery."
      },
      "gascityCockpit.ghostex.gxserverToken": {
        "type": "string",
        "default": "",
        "markdownDescription": "Bearer token for gxserver, sent as `Authorization: Bearer <token>`. Leave empty to read it from `~/.ghostex/gxserver/auth/token`."
      },
      "gascityCockpit.ghostex.pollSeconds": {
        "type": "number",
        "default": 10,
        "minimum": 2,
        "markdownDescription": "How often (seconds) to re-probe gxserver `/api/health` for liveness while the Ghostex view is in use."
      },
      "gascityCockpit.ghostex.reconnectBackoffMs": {
        "type": "number",
        "default": 500,
        "minimum": 50,
        "markdownDescription": "Base delay (ms) for exponential backoff when reconnecting the gxserver `/api/events` WebSocket. The ceiling is fixed at 15s."
      }
    }
  }
}
