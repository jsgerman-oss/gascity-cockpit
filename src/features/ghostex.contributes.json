{
  "viewsContainers": {
    "activitybar": [
      {
        "id": "gascityCockpitGhostex",
        "title": "Ghostex",
        "icon": "media/cockpit.svg"
      }
    ]
  },
  "views": {
    "gascityCockpitGhostex": [
      {
        "id": "gascityCockpitGhostex.sessions",
        "name": "Sessions",
        "icon": "media/cockpit.svg",
        "contextualTitle": "Ghostex Sessions"
      }
    ]
  },
  "commands": [
    {
      "command": "gascityCockpit.ghostex.refresh",
      "title": "Refresh Ghostex",
      "category": "Ghostex",
      "icon": "$(refresh)"
    },
    {
      "command": "gascityCockpit.ghostex.checkConnection",
      "title": "Ghostex: Check gxserver Connection",
      "category": "Ghostex",
      "icon": "$(plug)"
    },
    {
      "command": "gascityCockpit.ghostex.showOutput",
      "title": "Ghostex: Show Output",
      "category": "Ghostex",
      "icon": "$(output)"
    },
    {
      "command": "gascityCockpit.ghostex.session.copyRef",
      "title": "Ghostex: Copy Session Reference",
      "category": "Ghostex",
      "icon": "$(copy)"
    },
    {
      "command": "gascityCockpit.ghostex.session.focus",
      "title": "Ghostex: Focus Session",
      "category": "Ghostex",
      "icon": "$(eye)"
    },
    {
      "command": "gascityCockpit.ghostex.session.read",
      "title": "Ghostex: Read Session Output",
      "category": "Ghostex",
      "icon": "$(book)"
    },
    {
      "command": "gascityCockpit.ghostex.session.send",
      "title": "Ghostex: Send Text to Session…",
      "category": "Ghostex",
      "icon": "$(comment)"
    },
    {
      "command": "gascityCockpit.ghostex.session.sleep",
      "title": "Ghostex: Sleep Session",
      "category": "Ghostex",
      "icon": "$(debug-pause)"
    },
    {
      "command": "gascityCockpit.ghostex.session.wake",
      "title": "Ghostex: Wake Session",
      "category": "Ghostex",
      "icon": "$(debug-start)"
    },
    {
      "command": "gascityCockpit.ghostex.session.kill",
      "title": "Ghostex: Stop Session",
      "category": "Ghostex",
      "icon": "$(stop-circle)"
    },
    {
      "command": "gascityCockpit.ghostex.project.newSession",
      "title": "Ghostex: New Terminal Session",
      "category": "Ghostex",
      "icon": "$(terminal)"
    },
    {
      "command": "gascityCockpit.ghostex.project.newAgentSession",
      "title": "Ghostex: New Agent Session",
      "category": "Ghostex",
      "icon": "$(hubot)"
    },
    {
      "command": "gascityCockpit.ghostex.proxySession",
      "title": "Ghostex: Proxy gas-city Session…",
      "category": "Ghostex",
      "icon": "$(remote)"
    }
  ],
  "menus": {
    "commandPalette": [
      { "command": "gascityCockpit.ghostex.session.copyRef", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.focus", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.read", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.send", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.sleep", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.wake", "when": "false" },
      { "command": "gascityCockpit.ghostex.session.kill", "when": "false" },
      { "command": "gascityCockpit.ghostex.project.newSession", "when": "false" },
      { "command": "gascityCockpit.ghostex.project.newAgentSession", "when": "false" }
    ],
    "view/title": [
      {
        "command": "gascityCockpit.ghostex.proxySession",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@0"
      },
      {
        "command": "gascityCockpit.ghostex.refresh",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@1"
      },
      {
        "command": "gascityCockpit.ghostex.checkConnection",
        "when": "view == gascityCockpitGhostex.sessions",
        "group": "navigation@2"
      }
    ],
    "view/item/context": [
      {
        "command": "gascityCockpit.ghostex.project.newSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem == ghostexProject",
        "group": "inline@1"
      },
      {
        "command": "gascityCockpit.ghostex.project.newSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem == ghostexProject",
        "group": "1_new@1"
      },
      {
        "command": "gascityCockpit.ghostex.project.newAgentSession",
        "when": "view == gascityCockpitGhostex.sessions && viewItem == ghostexProject",
        "group": "1_new@2"
      },
      {
        "command": "gascityCockpit.ghostex.session.focus",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession\\./",
        "group": "1_session@1"
      },
      {
        "command": "gascityCockpit.ghostex.session.read",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession\\./",
        "group": "1_session@2"
      },
      {
        "command": "gascityCockpit.ghostex.session.send",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession\\./",
        "group": "1_session@3"
      },
      {
        "command": "gascityCockpit.ghostex.session.copyRef",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession\\./",
        "group": "1_session@4"
      },
      {
        "command": "gascityCockpit.ghostex.session.copyRef",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /^ghostexSession\\./",
        "group": "inline@1"
      },
      {
        "command": "gascityCockpit.ghostex.session.sleep",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /\\.running$/",
        "group": "2_lifecycle@1"
      },
      {
        "command": "gascityCockpit.ghostex.session.wake",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /\\.(sleeping|stopped|missing)$/",
        "group": "2_lifecycle@2"
      },
      {
        "command": "gascityCockpit.ghostex.session.kill",
        "when": "view == gascityCockpitGhostex.sessions && viewItem =~ /\\.(running|sleeping|unknown)$/",
        "group": "2_lifecycle@3"
      }
    ]
  },
  "configuration": {
    "title": "GasCity Cockpit",
    "properties": {
      "gascityCockpit.ghostex.gxPath": {
        "type": "string",
        "default": "gx",
        "markdownDescription": "Path to the Ghostex `gx` CLI binary. Default `gx` (resolved on `PATH`). Set an absolute path if `gx` is not on the editor's `PATH`."
      },
      "gascityCockpit.ghostex.gxserverUrl": {
        "type": "string",
        "default": "",
        "markdownDescription": "Base URL of the gxserver RPC daemon (e.g. `http://127.0.0.1:58744`). Leave empty to use the documented local default. Overrides discovery."
      },
      "gascityCockpit.ghostex.gxserverToken": {
        "type": "string",
        "default": "",
        "markdownDescription": "Bearer token for gxserver, sent as `Authorization: Bearer <token>`. Leave empty to read it from `~/.ghostex/gxserver/auth/token`."
      },
      "gascityCockpit.ghostex.pollSeconds": {
        "type": "number",
        "default": 10,
        "minimum": 2,
        "markdownDescription": "How often (seconds) to re-probe gxserver `/api/health` for liveness while the Ghostex view is in use."
      },
      "gascityCockpit.ghostex.reconnectBackoffMs": {
        "type": "number",
        "default": 500,
        "minimum": 50,
        "markdownDescription": "Base delay (ms) for exponential backoff when reconnecting the gxserver `/api/events` WebSocket. The ceiling is fixed at 15s."
      }
    }
  }
}
