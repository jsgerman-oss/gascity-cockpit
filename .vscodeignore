# Everything except the bundled extension is excluded from the .vsix.
# openapi-fetch (the one runtime dep) is bundled into dist/ by esbuild, so
# node_modules is not shipped (package script uses `vsce package --no-dependencies`).
.vscode/**
.vscode-test/**
.github/**
node_modules/**
out/**
coverage/**

src/**
scripts/**
# Non-extension build targets (the fleet-status CLI, future ACP/MCP adapters).
# Only dist/extension.js is the extension; the CLI bundle ships separately.
targets/**
dist/targets/**
openapi/**
docs/**
.beads/**
.gc/**
.claude/**

esbuild.mjs
eslint.config.mjs
vitest.config.ts
tsconfig.json
.gitignore
.eslintcache

**/*.ts
**/*.map
**/*.test.*
