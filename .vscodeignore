# Everything except the bundled extension is excluded from the .vsix.
# openapi-fetch (the one runtime dep) is bundled into dist/ by esbuild, so
# node_modules is not shipped (package script uses `vsce package --no-dependencies`).
.vscode/**
.vscode-test/**
.github/**
node_modules/**
out/**
coverage/**

src/**
scripts/**
# Non-extension build targets (the fleet-status CLI, the standalone web +
# companion apps, future ACP/MCP adapters). Only dist/extension.js is the
# extension; these bundles ship/run separately. The dashboard webview frames an
# external URL rather than loading dist/web, so none of these are runtime assets.
targets/**
packages/**
dist/targets/**
dist/web/**
dist/companion/**
openapi/**
docs/**
.beads/**
.gc/**
.claude/**
.serena/**
# The marketing site (deployed separately via deploy-site.yml) and the gas-city
# agent pack (a standalone deliverable installed into cities, not loaded by the
# extension at runtime) are not part of the bundled extension.
site/**
pack/**

esbuild.mjs
eslint.config.mjs
vitest.config.ts
tsconfig.json
.gitignore
.eslintcache
.rafter.yml

**/*.ts
**/*.map
**/*.test.*
